{
  "name": "google-ai-ecosystem-gemini-mcp",
  "version": "2.0.0",
  "private": true,
  "description": "Private Gemini Web MCP runtime bundled with the Google AI Ecosystem skill",
  "type": "module",
  "bin": {
    "gemini-mcp": "dist/index.js"
  },
  "scripts": {
    "prebuild": "node scripts/clean-dist.mjs",
    "build": "tsc",
    "postbuild": "node -e \"if (process.platform !== 'win32') require('node:fs').chmodSync('dist/index.js', 0o755)\"",
    "smoke": "node scripts/server-lifecycle-smoke.mjs",
    "smoke:real": "node scripts/mcp-smoke-test.mjs",
    "test:media-capacity": "node scripts/media-capacity-test.mjs",
    "watch": "tsc --watch",
    "dev": "tsx watch src/index.ts",
    "test": "tsx --test tests/**/*.test.ts",
    "test:unit": "tsx --test tests/**/*.test.ts",
    "test:python": "python -B -m unittest discover -s ../../tests -v",
    "package:check": "node scripts/package-check.mjs",
    "license:check": "node scripts/verify-license.mjs",
    "provenance:check": "node scripts/verify-provenance.mjs",
    "start": "node dist/index.js"
  },
  "keywords": [
    "mcp",
    "gemini",
    "google",
    "ai",
    "google-ai-ecosystem"
  ],
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "VENDOR.json",
    "docs"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "dotenv": "^16.4.0",
    "env-paths": "^3.0.0",
    "globby": "^14.1.0",
    "patchright": "^1.48.2",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
